if(missing(folder))
{
setwd(print(paste(if (Sys.info()[["sysname"]]=="Windows") {("C:/GitHub")} else {
if (Sys.info()[["sysname"]]=="Darwin"){("/Users/lydiameckley/GitHub")} else ("for Linux run: setwd('/home/[LydiaMeckley]/GitHub')")
},"/",repo, sep = "")))}
else
{
setwd(print(paste(if (Sys.info()[["sysname"]]=="Windows") {("C:/GitHub")} else {
if (Sys.info()[["sysname"]]=="Darwin"){("/Users/lydiameckley/GitHub")} else ("for Linux run: setwd('/home/[LydiaMeckley]/GitHub')")
},"/",repo, "/", folder, sep = "")))}
}
LM_wd("meckleylg")
###PACKAGES###
library(rgbif)
library(dplyr)
library(readxl)
library(vegan)
library(fitdistrplus)
library(logspline)
library(MASS)
library(MuMIn)
library(mgcv)
###DATASETS###
#COASTAL WATER DATA#
LM_wd(repo="meckleylg", folder="Final Project")
waterdata <- read.csv("UK_Water_Data.csv")
#SEAL DATA#
# 1. Species Keys
h_key <- name_backbone("Phoca vitulina")$usageKey
g_key <- name_backbone("Halichoerus grypus")$usageKey
inat_dataset <- "50c9509d-22c7-4a22-a47d-8c48425ef4a7"
# 2. Define the years we want
years <- 2007:2018
# 3. Create a helper function to fetch one year at a time
get_yearly_data <- function(yr, species_key, label) {
# We add a small pause (0.5s) to avoid hitting rate limits
Sys.sleep(0.5)
# Fetch count
cnt <- occ_count(
taxonKey = species_key,
country = "GB",
datasetKey = inat_dataset,
year = yr
)
return(data.frame(year = yr, count = cnt, species = label))
}
# 4. Run the loop (this might take a minute, but it's safer)
harbor_list <- lapply(years, get_yearly_data, species_key = h_key, label = "Harbor Seal")
grey_list   <- lapply(years, get_yearly_data, species_key = g_key, label = "Grey Seal")
# 5. Combine results
sealdata <- bind_rows(harbor_list, grey_list)
###REMOVE COLUMNS I DO NOT NEED FROM THE COASTAL WATER DATASET###
waterdata <- waterdata[,-1]
waterdata <- waterdata[,-2:-6]
waterdata <- waterdata[,-3:-7]
waterdata <- waterdata[,-6]
###SUBSET THE COASTAL WATER DATA TO ONLY HAVE DATA FROM THE COUNTRY "ENGLAND"###
waterdata <- subset(waterdata, Country == "England")
###MEAN THE COASTAL WATER DATA BY YEAR###
waterdata <- na.omit(waterdata)
waterdata$Year <- paste(waterdata$Year)
water.means <- aggregate(x = waterdata, by = list(waterdata$Year), FUN = "mean")
###REMOVE NAs FROM THE COASTAL WATER DATA###
water.means <- water.means[,-2:-3]
###CHANGE THE COLUMN NAME OF THE YEAR COLUMN BACK TO "YEAR"###
colnames(water.means)[1] <- "Year"
###MERGE BOTH OF THE DATASETS (COSTAL WATER DATA AND SEAL POPULATION DATA)###
seal.water <- merge(water.means, sealdata, by.x = "Year", by.y = "year")
###CREATE A GLMM WITH AN INTERACTIVE EFFECT BETWEEN TEMPERATURE AND YEAR TO SEE HOW IT PREDICTS EACH OF THE SEAL SPECIES###
glmm.mod <- glmmPQL(count ~ Temp * Year, family = gaussian, random = ~ 1 | species, data = seal.water)
gam.mod <- gam(count~Temp*Year+species, data = seal.water)
summary(gam.mod)
seal.water$Year <- as.numeric(seal.water$Year)
gam.mod <- gam(count~Temp*Year+species, data = seal.water)
summary(gam.mod)
library(itsadug)
#plot for the stinky glmm (or gam...)
par(mfrow = c(1, 2))
plot_smooth(gam.mod, view="Year", rm.ranef=FALSE)
plot_smooth(gam.mod, view="Temp", rm.ranef=FALSE)
plot_smooth(gam.mod, view="Year", rm.ranef=FALSE, ylab = "Temperature (C°)", xlab = "Seal Species")
plot_smooth(gam.mod, view="Year", rm.ranef=FALSE, ylab = "Seal Species", xlab = "Temperature (C°)")
plot_smooth(gam.mod, view="Year", rm.ranef=FALSE, ylab = "Seal Species", xlab = "Temperature (C°)")
#plot for the stinky glmm (or gam...)
par(mfrow = c(1, 2))
plot_smooth(gam.mod, view="Year", rm.ranef=FALSE, ylab = "Seal Species", xlab = "Temperature (C°)")
plot_smooth(gam.mod, view="Temp", rm.ranef=FALSE, ylab = "Seal Species", xlab = "Year")
###PLOT FOR THE GAM TO VISUALIZE THE INTERACTIVE EFFECT OF TEMPERATURE AND YEAR ON BOTH SEAL SPECIES###
par(mfrow = c(1, 2))
plot_smooth(gam.mod+species, view="Year", rm.ranef=FALSE, ylab = "Seal Species", xlab = "Temperature (C°)")
plot_smooth(gam.mod, view="Year", rm.ranef=FALSE, ylab = "Seal Species", xlab = "Temperature (C°)")
plot_smooth(gam.mod, view="Temp", rm.ranef=FALSE, ylab = "Seal Species", xlab = "Year")
View(seal.water)
###SUBSET EACH SEAL SPECIES TO MAKE A GAM FOR THEM###
harbor.seal <- subset(seal.water, species == "Harbor Seal")
grey.seal <- subset(seal.water, species == "Grey Seal")
###CREATE INDIVIDUAL GAMS FOR EACH SEAL SPECIES###
gam.mod2 <- gam(species~Temp*Year, data = harbor.seal)
View(harbor.seal)
###CREATE INDIVIDUAL GAMS FOR EACH SEAL SPECIES###
gam.mod2 <- gam(count~Temp*Year, data = harbor.seal)
gam.mod3 <- gam(count~Temp*Year, data = grey.seal)
summary(gam.mod2)
summary(gam.mod3)
plot_smooth(gam.mod2 + gam.mod2, view="Year", rm.ranef=FALSE, ylab = "Seal Species", xlab = "Temperature (C°)")
plot_smooth(gam.mod2 + gam.mod3, view="Year", rm.ranef=FALSE, ylab = "Seal Species", xlab = "Temperature (C°)")
plot_smooth(gam.mod2, gam.mod3, view="Year", rm.ranef=FALSE, ylab = "Seal Species", xlab = "Temperature (C°)")
plot_smooth(gam.mod2, gam.mod3, view="Temp", rm.ranef=FALSE, ylab = "Seal Species", xlab = "Year")
###PLOT FOR THE GAM TO VISUALIZE THE INTERACTIVE EFFECT OF TEMPERATURE AND YEAR ON BOTH SEAL SPECIES###
par(mfrow = c(1, 2))
plot_smooth(gam.mod2, view="Year", rm.ranef=FALSE, ylab = "Seal Species", xlab = "Temperature (C°)")
plot_smooth(gam.mod2, view="Temp", rm.ranef=FALSE, ylab = "Seal Species", xlab = "Year")
plot_smooth(gam.mod3, view="Year", rm.ranef=FALSE, ylab = "Seal Species", xlab = "Temperature (C°)")
plot_smooth(gam.mod3, view="Temp", rm.ranef=FALSE, ylab = "Seal Species", xlab = "Year")
###PLOT FOR THE GAM TO VISUALIZE THE INTERACTIVE EFFECT OF TEMPERATURE AND YEAR ON BOTH SEAL SPECIES###
par(mfrow = c(2, 2))
plot_smooth(gam.mod2, view="Year", rm.ranef=FALSE, ylab = "Seal Species", xlab = "Temperature (C°)")
plot_smooth(gam.mod2, view="Temp", rm.ranef=FALSE, ylab = "Seal Species", xlab = "Year")
plot_smooth(gam.mod3, view="Year", rm.ranef=FALSE, ylab = "Seal Species", xlab = "Temperature (C°)")
plot_smooth(gam.mod3, view="Temp", rm.ranef=FALSE, ylab = "Seal Species", xlab = "Year")
###PLOT FOR THE GAM TO VISUALIZE THE INTERACTIVE EFFECT OF TEMPERATURE AND YEAR ON BOTH SEAL SPECIES###
par(mfrow = c(2, 2))
plot_smooth(gam.mod2, view="Year", rm.ranef=FALSE, ylab = "Harbor Seal", xlab = "Temperature (C°)")
plot_smooth(gam.mod2, view="Temp", rm.ranef=FALSE, ylab = "Harbor Seal", xlab = "Year")
plot_smooth(gam.mod3, view="Year", rm.ranef=FALSE, ylab = "Grey Seal", xlab = "Temperature (C°)")
plot_smooth(gam.mod3, view="Temp", rm.ranef=FALSE, ylab = "Grey Seal", xlab = "Year")
###PLOT FOR THE GAM TO VISUALIZE THE INTERACTIVE EFFECT OF TEMPERATURE AND YEAR ON BOTH SEAL SPECIES###
par(mfrow = c(2, 2))
plot_smooth(gam.mod2, view="Year", rm.ranef=FALSE, ylab = "Harbor Seal", xlab = "Year")
plot_smooth(gam.mod2, view="Temp", rm.ranef=FALSE, ylab = "Harbor Seal", xlab = "Temperature (C°)")
plot_smooth(gam.mod3, view="Year", rm.ranef=FALSE, ylab = "Grey Seal", xlab = "Year")
plot_smooth(gam.mod3, view="Temp", rm.ranef=FALSE, ylab = "Grey Seal", xlab = "Temperature (C°)")
LM_wd <- function (repo, folder=NULL) {
if(missing(folder))
{
setwd(print(paste(if (Sys.info()[["sysname"]]=="Windows") {("C:/GitHub")} else {
if (Sys.info()[["sysname"]]=="Darwin"){("/Users/lydiameckley/GitHub")} else ("for Linux run: setwd('/home/[LydiaMeckley]/GitHub')")
},"/",repo, sep = "")))}
else
{
setwd(print(paste(if (Sys.info()[["sysname"]]=="Windows") {("C:/GitHub")} else {
if (Sys.info()[["sysname"]]=="Darwin"){("/Users/lydiameckley/GitHub")} else ("for Linux run: setwd('/home/[LydiaMeckley]/GitHub')")
},"/",repo, "/", folder, sep = "")))}
}
LM_wd("meckleylg")
