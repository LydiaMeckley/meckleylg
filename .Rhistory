###PACKAGES###
library(rgbif)
library(dplyr)
library(readxl)
library(vegan)
library(fitdistrplus)
library(logspline)
library(MASS)
library(MuMIn)
library(mgcv)
library(itsadug)
###DATASETS###
#COASTAL WATER DATA#
LM_wd(repo="meckleylg", folder="Final Project")
waterdata <- read.csv("UK_Water_Data.csv")
#SEAL DATA#
# 1. Species Keys
h_key <- name_backbone("Phoca vitulina")$usageKey
g_key <- name_backbone("Halichoerus grypus")$usageKey
inat_dataset <- "50c9509d-22c7-4a22-a47d-8c48425ef4a7"
# 2. Define the years we want
years <- 2007:2018
# 3. Create a helper function to fetch one year at a time
get_yearly_data <- function(yr, species_key, label) {
# We add a small pause (0.5s) to avoid hitting rate limits
Sys.sleep(0.5)
# Fetch count
cnt <- occ_count(
taxonKey = species_key,
country = "GB",
datasetKey = inat_dataset,
year = yr
)
return(data.frame(year = yr, count = cnt, species = label))
}
# 4. Run the loop (this might take a minute, but it's safer)
harbor_list <- lapply(years, get_yearly_data, species_key = h_key, label = "Harbor Seal")
grey_list   <- lapply(years, get_yearly_data, species_key = g_key, label = "Grey Seal")
# 5. Combine results
sealdata <- bind_rows(harbor_list, grey_list)
###REMOVE COLUMNS I DO NOT NEED FROM THE COASTAL WATER DATASET###
waterdata <- waterdata[,-1]
waterdata <- waterdata[,-2:-6]
waterdata <- waterdata[,-3:-7]
waterdata <- waterdata[,-6]
###SUBSET THE COASTAL WATER DATA TO ONLY HAVE DATA FROM THE COUNTRY "ENGLAND"###
waterdata <- subset(waterdata, Country == "England")
###MEAN THE COASTAL WATER DATA BY YEAR###
waterdata <- na.omit(waterdata)
waterdata$Year <- paste(waterdata$Year)
water.means <- aggregate(x = waterdata, by = list(waterdata$Year), FUN = "mean")
###REMOVE NAs FROM THE COASTAL WATER DATA###
water.means <- water.means[,-2:-3]
###CHANGE THE COLUMN NAME OF THE YEAR COLUMN BACK TO "YEAR"###
colnames(water.means)[1] <- "Year"
###MERGE BOTH OF THE DATASETS (COSTAL WATER DATA AND SEAL POPULATION DATA)###
seal.water <- merge(water.means, sealdata, by.x = "Year", by.y = "year")
###climate variability and oxygen (and relate that to the seals conceptually)
#sd of temperature and oxygen over all the years?
sdtemp <- aggregate(Temp ~ Year, data = waterdata, FUN = sd)
sdoxygen <- aggregate(Oxygen ~ Year, data = waterdata, FUN = sd)
climate <- merge(sdtemp, sdoxygen, by = "Year")
View(climate)
mod4 <- lm(Temp, Oxygen ~ Year, family = lnorm, data = climate)
mod4 <- lm(Temp + Oxygen ~ Year, family = lnorm, data = climate)
summary(mod4)
mod4 <- lm(Oxygen ~ Year, family = lnorm, data = climate)
climate$Year <- as.numeric(climate$Year)
mod4 <- lm(Oxygen ~ Year, family = lnorm, data = climate)
summary(mod4)
mod5 <- lm(Temp ~ Year, family = lnorm, data = climate)
summary(mod5)
fit.weibull <- fitdist(climate$Oxygen, distr = "weibull")
fit.norm <- fitdist(climate$Oxygen, distr = "norm")
fit.gamma <- fitdist(climate$Oxygen, distr = "gamma")
fit.lnorm <- fitdist(climate$Oxygen, distr = "lnorm")
fit.nbinom <- fitdist(climate$Oxygen, distr = "nbinom")
fit.logis <- fitdist(climate$Oxygen, distr = "logis")
fit.geom <- fitdist(climate$Oxygen, distr = "geom")
gofstat(list(fit.weibull, fit.norm, fit.gamma,
fit.lnorm, fit.nbinom, fit.logis, fit.geom))
mod6 <- lm(Year ~ Temp + Oxygen, family = lnorm, data = climate)
summary(mod6)
mod4 <- lm(Temp ~ Year + Oxygen, family = lnorm, data = climate)
summary(mod4)
#oxygen as a covariate
plot(mod4)
plot(climate$Year, climate$Temp, type = "n",
main = "Temp over Years by Oxygen Level",
xlab = "Year", ylab = "Temperature")
plot(climate$Temp, climate$Year, type = "n",
main = "Temp over Years by Oxygen Level",
xlab = "Year", ylab = "Temperature")
plot(climate$Temp ~ climate$Year, xlab = "Year", ylab = "Temperature by Oxygen", pch=16, col = "navyblue")
abline(lm(climate$Temp ~ climate$Year), col = "black")
plot(climate$Temp ~ climate$Year, xlab = "Year", ylab = "SD Temperature by Oxygen", pch=16, col = "navyblue")
abline(lm(climate$Temp ~ climate$Year), col = "black")
plot(climate$Temp ~ climate$Oxygen, xlab = "SD Oxygen", ylab = "SD Temperature", pch=16, col = "navyblue")
###cool! - should I use this too?
plot(climate$Temp ~ climate$Oxygen, xlab = "SD Oxygen", ylab = "SD Temperature (C°)", pch=16, col = "navyblue")
plot(climate$Temp ~ climate$Year, xlab = "Year", ylab = "SD Temperature (C°)", pch=16, col = "navyblue")
abline(lm(climate$Temp ~ climate$Year), col = "black")
