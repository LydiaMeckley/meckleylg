decomposers <- invert.mean2[,-1:-36]
decomposers2 <- decomposers[,-8:-17]
View(invert.df)
decomposers2$Parcel <- unique(invert.df$Parcel)
View(abiotic.df)
View(abiotic.mean1)
View(invert.mean2)
View(invert.df1)
View(abiotic.df)
invertdf2 <- invert.df[-9:-10,]
View(invertdf2)
decomposers2$Parcel <- unique(invert.df2$Parcel)
decomposers2$Parcel <- unique(invertdf2$Parcel)
decomposers3 <- merge(abiotic.mean2, decomposers2, by = "Parcel")
fit.weibull <- fitdist(decomposers3, distr = "weibull") ###
